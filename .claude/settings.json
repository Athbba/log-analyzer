{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Bash(node bin/analyze.js *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git push *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(docker compose *)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(npm publish *)",
      "Bash(rm -rf *)"
    ]
  }
}
