{
  "name": "log-analyzer",
  "version": "0.1.0",
  "description": "Detects brute force, likely break-ins, off-hours logins and backdoor accounts in Linux SSH auth.log files",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "ssh-log-analyzer": "bin/analyze.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "analyze": "node bin/analyze.js",
    "test": "node --test",
    "lint": "eslint .",
    "typecheck": "tsc -p . && tsc -p test",
    "check": "npm run lint && npm run typecheck && npm test",
    "generate-sample": "node scripts/generate-sample-log.js",
    "lab": "node scripts/lab.js run",
    "lab:fixture": "node scripts/lab.js run --out test/fixtures/lab/auth.log"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "typescript": "6.0.3"
  }
}
